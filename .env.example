# Copy this file to .env (same folder) and fill in your keys. Never commit .env.

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# console.deepgram.com → API Keys
DEEPGRAM_API_KEY=

# Optional
# PORT=3001
# CLAUDE_MODEL=claude-opus-5-5        # board reading (vision)
# CLAUDE_TEXT_MODEL=claude-haiku-5-5  # notes, mind map, focus, catch-ups, topic notes
# DEEPGRAM_MODEL=nova-3
# MINDMAP_INTERVAL_MS=45000
# TEACHER_KEY=pick-a-secret   # then open the teacher console as /teach/?key=pick-a-secret
